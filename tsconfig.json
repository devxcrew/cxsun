{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "types": ["vite/client", "node"],
    "paths": {
      "@/*": ["./src/web/*"],
      "@codexsun/ui/tokens": ["../../shared/ui/src/tokens/index.ts"]
    }
  },
  "include": ["src/web", "src/contracts", "src/config", "vite.config.ts"]
}
