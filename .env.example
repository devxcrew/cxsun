APP_NAME=Cxsun
APP_PORT=5173
APP_URL=http://127.0.0.1:5173
APP_MODE=production
APP_HOST=127.0.0.1

# mcp
MCP_SERVER_URL=https://mcp.codexsun.com/mcp
MCP_SERVER_SECRET=
APP_ID=cxsun
APP_USER=developer

# Database connection
DB_DRIVER=mariadb
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_MASTER_NAME=cx_master_db
# MariaDB master connection; configure credentials in ignored .env only.
# SQLite recovery source; the production runtime does not use this file.
DB_SQLITE_PATH=storage/private/data/identity.sqlite
DB_BACKUP_DIR=storage/private/data/backup
# Optional executable paths when MariaDB clients are not on PATH.
DB_DUMP_BIN=
DB_CLIENT_BIN=

# Database identity
IDENTITY_MODE=multi-tenant
IDENTITY_TENANT_ID=default
IDENTITY_TENANT_NAME='Cxsun organization'
IDENTITY_SESSION_SECONDS=28800

# === Bootstrap users ===
# Optional first platform users. Leave blank on live and create users
# manually unless this deployment intentionally needs a seeded account.
SUPER_ADMIN_NAME=SUNDAR
SUPER_ADMIN_EMAIL=sundar@sundar.com
SUPER_ADMIN_PASSWORD=

SOFTWARE_ADMIN_NAME=Admin
SOFTWARE_ADMIN_EMAIL=admin@admin.com
SOFTWARE_ADMIN_PASSWORD=

# --- Tenant administrator bootstrap ---
# Optional tenant setup helper account. Leave blank on live unless you
# intentionally want every newly setup tenant to receive this admin user.
TENANT_ADMIN_NAME=tenant
TENANT_ADMIN_EMAIL=admin@tenant.com
TENANT_ADMIN_PASSWORD=

# === Storage ===
STORAGE_ROOT=storage/app
STORAGE_PUBLIC_ROOT=storage/public

# Identity lifecycle delivery. Required for invitation and recovery acceptance.
EMAIL_ENABLED=0
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=0
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=

# Restart only a verified development process owned by this app.
DEVXCREW_DEV_PORT_POLICY=restart

# Connection cache (in addition to the master)
DB_POOL_CACHE_LIMIT=16
DB_POOL_IDLE_MS=300000
