{
  "name": "@codexsun/cxsun",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "npm": ">=12.2.0",
    "node": ">=26.10.0"
  },
  "scripts": {
    "dev": "concurrently -k -n server,web \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "tsx watch --env-file-if-exists=.env src/server/index.ts",
    "dev:web": "vite",
    "typecheck": "node node_modules/typescript/bin/tsc --noEmit && node node_modules/typescript/bin/tsc -p tsconfig.server.json --noEmit",
    "build": "npm run typecheck && vite build && node node_modules/typescript/bin/tsc -p tsconfig.server.json",
    "start": "node --env-file-if-exists=.env dist/server/server/index.js",
    "test": "tsx --test tests/*.test.ts",
    "lint": "eslint src tests vite.config.ts",
    "format": "prettier --write src tests *.json *.ts *.md",
    "format:check": "prettier --check src tests *.json *.ts *.md",
    "desktop:dev": "tauri dev",
    "desktop:build": "tauri build",
    "infra:up": "docker compose up -d",
    "infra:down": "docker compose down",
    "check": "npm run lint && npm run typecheck && npm test",
    "packages:check": "node tools/check-packages.mjs",
    "compiler:version": "node node_modules/typescript/bin/tsc --version",
    "test:production": "node tools/production-smoke.mjs"
  },
