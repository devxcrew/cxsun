{
  "name": "@codexsun/cxsun",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "engines": {
    "npm": ">=12.2.0",
    "node": ">=26.10.0"
  },
  "scripts": {
    "dev": "node tools/dev.mjs",
    "dev:server": "npm run dev",
    "dev:web": "npm run dev",
    "typecheck": "node node_modules/typescript/bin/tsc --noEmit && node node_modules/typescript/bin/tsc -p tsconfig.server.json --noEmit",
    "build": "devxcrew-tools app:build",
    "start": "node --env-file=.env dist/api/index.js",
    "test": "tsx --test tests/*.test.ts tests/*.test.mjs src/api/database/*.test.ts src/web/modules/identity/*.test.ts",
    "lint": "eslint src tests vite.config.ts",
    "format": "prettier --write src tests *.json *.ts *.md",
    "format:check": "prettier --check src tests *.json *.ts *.md",
    "check": "npm run tools:check && npm run lint && npm run typecheck && npm test",
    "packages:check": "node tools/check-packages.mjs",
    "compiler:version": "node node_modules/typescript/bin/tsc --version",
    "test:production": "node tools/production-smoke.mjs && npm run test:identity",
    "tools:check": "devxcrew-tools dependencies:order && devxcrew-tools dependencies:check && devxcrew-tools check:versions && devxcrew-tools lines:check",
    "tools:env": "devxcrew-tools env:init",
    "tools:lines:fix": "devxcrew-tools lines:fix",
    "github:now": "devxcrew-tools github:now",
    "version:update": "devxcrew-tools version:bump",
    "version:bump": "devxcrew-tools version:bump",
    "check:versions": "devxcrew-tools check:versions",
    "fix:line-endings": "devxcrew-tools lines:fix",
    "lines:check": "devxcrew-tools lines:check",
    "version:show": "devxcrew-tools version:show",
    "changelog:append": "devxcrew-tools changelog:append",
    "changelog:show": "devxcrew-tools changelog:show",
    "verify": "npm run check && npm run build && npm run test:production",
    "mcp:connect": "node agent/connect.mjs",
    "mcp:verify": "node agent/connect.mjs --strict",
    "version-bump": "devxcrew-tools version:bump",
    "packages:local": "node tools/shared-packages.mjs local",
    "packages:npm": "node tools/shared-packages.mjs npm",
    "setup": "npm run tools:env && npm run mcp:verify && npm run db:setup",
    "db:migrate": "node --env-file=.env --import tsx src/api/database/database.command.ts migrate",
    "db:seed": "node --env-file=.env --import tsx src/api/database/database.command.ts seed",
    "db:check": "node --env-file=.env --import tsx src/api/database/database.command.ts check",
    "db:setup": "npm run db:migrate && npm run db:seed",
    "packages:platform": "node tools/platform-package.mjs",
    "test:identity": "node tools/identity-smoke.mjs",
    "db:backup": "node --env-file=.env --import tsx src/api/database/database.command.ts backup",
    "db:verify-backup": "node --import tsx src/api/database/database.command.ts verify-backup",
    "test:live": "node --env-file=.env tools/live-identity-check.mjs",
    "email:check": "node --env-file=.env tools/email-check.mjs",
    "test:consumers": "node tools/local-consumer-check.mjs"
  },
  "dependencies": {
    "@devxcrew/core-framework": "^0.1.7",
    "@devxcrew/email": "file:vendor/devxcrew-email-0.1.0.tgz",
    "@devxcrew/platform": "file:vendor/devxcrew-platform-0.1.1.tgz",
    "@devxcrew/react-ui": "^0.1.7",
    "@fontsource-variable/geist": "^5.3.0",
    "@tanstack/react-form": "^1.33.5",
    "@tanstack/react-router": "^1.170.31",
    "kysely": "^0.29.5",
    "lucide-react": "^1.33.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@devxcrew/tools": "0.1.7",
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "latest",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@typescript-eslint/eslint-plugin": "^8.67.0",
    "@typescript-eslint/parser": "^8.67.0",
    "@vitejs/plugin-react": "^6.1.0",
    "concurrently": "^9.2.0",
    "deepmerge-ts": "^8.0.1",
    "eslint": "^10.8.1",
    "prettier": "^3.9.6",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.12",
    "typescript": "7.0.2",
    "typescript-eslint-compiler": "npm:typescript@6.0.3",
    "vite": "^8.2.2"
  },
  "packageManager": "npm@12.2.0",
  "allowScripts": {
    "esbuild": true
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/devxcrew/cxsun.git"
  }
}
